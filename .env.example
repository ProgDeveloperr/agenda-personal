# SOLO EJEMPLO. No incluir credenciales reales en Git.
# La aplicacion PHP lee /run/agenda/agenda.env dentro del contenedor.
# AGENDA_PUBLIC_HOST: dominio SIN https:// ni puerto.
AGENDA_PUBLIC_HOST=agenda.example.com
DB_HOST=database
DB_PORT=3306
DB_NAME=agenda_personal
DB_USER=agenda_app
DB_PASSWORD=REEMPLAZAR_EN_ARCHIVO_PRIVADO
# 32 bytes aleatorios en hexadecimal (64 caracteres).
# Generar con: openssl rand -hex 32
AGENDA_MFA_KEY_HEX=REEMPLAZAR_EN_ARCHIVO_PRIVADO_CON_64_HEX
